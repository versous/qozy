rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /habits/{habitId} {
      allow read, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;

      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'title', 'icon', 'frequencyDays', 'goalType', 'goalTarget',
          'goalUnit', 'userId', 'createdAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && (!request.resource.data.keys().hasAny(['goalType'])
          || request.resource.data.goalType in ['check', 'count', 'timer'])
        && (!request.resource.data.keys().hasAny(['goalTarget'])
          || (request.resource.data.goalTarget is int
            && request.resource.data.goalTarget >= 1
            && request.resource.data.goalTarget <= 10000))
        && (!request.resource.data.keys().hasAny(['goalUnit'])
          || (request.resource.data.goalUnit is string
            && request.resource.data.goalUnit.size() > 0
            && request.resource.data.goalUnit.size() <= 24))
        && (!request.resource.data.keys().hasAny(['frequencyDays'])
          || (request.resource.data.frequencyDays is list
            && request.resource.data.frequencyDays.size() > 0
            && request.resource.data.frequencyDays.hasOnly([0, 1, 2, 3, 4, 5, 6])));

      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'frequencyDays', 'goalType', 'goalTarget', 'goalUnit'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && (!request.resource.data.keys().hasAny(['goalType'])
          || request.resource.data.goalType in ['check', 'count', 'timer'])
        && (!request.resource.data.keys().hasAny(['goalTarget'])
          || (request.resource.data.goalTarget is int
            && request.resource.data.goalTarget >= 1
            && request.resource.data.goalTarget <= 10000))
        && (!request.resource.data.keys().hasAny(['goalUnit'])
          || (request.resource.data.goalUnit is string
            && request.resource.data.goalUnit.size() > 0
            && request.resource.data.goalUnit.size() <= 24))
        && (!request.resource.data.keys().hasAny(['frequencyDays'])
          || (request.resource.data.frequencyDays is list
            && request.resource.data.frequencyDays.size() > 0
            && request.resource.data.frequencyDays.hasOnly([0, 1, 2, 3, 4, 5, 6])));

      match /completions/{date} {
        allow get: if request.auth != null
          && get(/databases/$(database)/documents/habits/$(habitId)).data.userId == request.auth.uid;

        allow list: if request.auth != null
          && resource.data.userId == request.auth.uid;

        allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.habitId == habitId
          && request.resource.data.date == date
          && request.resource.data.keys().hasOnly([
            'habitId', 'date', 'userId', 'progress'
          ])
          && (!request.resource.data.keys().hasAny(['progress'])
            || (request.resource.data.progress is number
              && request.resource.data.progress >= 0
              && request.resource.data.progress <= 10000000))
          && get(/databases/$(database)/documents/habits/$(habitId)).data.userId == request.auth.uid;

        allow update: if request.auth != null
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.habitId == habitId
          && request.resource.data.date == date
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['progress'])
          && request.resource.data.progress is number
          && request.resource.data.progress >= 0
          && request.resource.data.progress <= 10000000;

        allow delete: if request.auth != null
          && resource.data.userId == request.auth.uid;
      }
    }

    match /exercises/{exerciseId} {
      allow read, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;

      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'name', 'duration', 'intensity', 'equipment', 'note',
          'selectedDate', 'completedDate', 'completedDates',
          'routineDays', 'routineEnabled', 'userId', 'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.duration is int
        && request.resource.data.duration > 0
        && request.resource.data.duration <= 180
        && (!request.resource.data.keys().hasAny(['completedDates'])
          || (request.resource.data.completedDates is list
            && request.resource.data.completedDates.size() <= 3660))
        && (!request.resource.data.keys().hasAny(['routineDays'])
          || (request.resource.data.routineDays is list
            && request.resource.data.routineDays.size() <= 7
            && request.resource.data.routineDays.hasOnly([0, 1, 2, 3, 4, 5, 6])))
        && (!request.resource.data.keys().hasAny(['routineEnabled'])
          || request.resource.data.routineEnabled is bool);

      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'name', 'duration', 'intensity', 'equipment', 'note',
            'selectedDate', 'completedDate', 'completedDates',
            'routineDays', 'routineEnabled'
          ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.duration is int
        && request.resource.data.duration > 0
        && request.resource.data.duration <= 180
        && request.resource.data.intensity is string
        && request.resource.data.equipment is string
        && request.resource.data.note is string
        && (request.resource.data.selectedDate == null
          || request.resource.data.selectedDate is string)
        && (request.resource.data.completedDate == null
          || request.resource.data.completedDate is string)
        && (!request.resource.data.keys().hasAny(['completedDates'])
          || (request.resource.data.completedDates is list
            && request.resource.data.completedDates.size() <= 3660))
        && (!request.resource.data.keys().hasAny(['routineDays'])
          || (request.resource.data.routineDays is list
            && request.resource.data.routineDays.size() <= 7
            && request.resource.data.routineDays.hasOnly([0, 1, 2, 3, 4, 5, 6])))
        && (!request.resource.data.keys().hasAny(['routineEnabled'])
          || request.resource.data.routineEnabled is bool);
    }

    match /tasks/{taskId} {
      allow read, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;

      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'title', 'description', 'priority', 'dueDate',
          'completed', 'completedDate', 'completedDates', 'userId',
          'createdAt', 'startTime', 'durationMinutes'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.description is string
        && request.resource.data.priority in ['urgent', 'important', 'normal']
        && (request.resource.data.dueDate == null
          || request.resource.data.dueDate is string)
        && request.resource.data.completed is bool
        && (!request.resource.data.keys().hasAny(['completedDate'])
          || request.resource.data.completedDate == null
          || request.resource.data.completedDate is string)
        && (!request.resource.data.keys().hasAny(['completedDates'])
          || (request.resource.data.completedDates is list
            && request.resource.data.completedDates.size() <= 3660))
        && (!request.resource.data.keys().hasAny(['startTime'])
          || request.resource.data.startTime == null
          || (request.resource.data.startTime is string
            && request.resource.data.startTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))
        && (!request.resource.data.keys().hasAny(['durationMinutes'])
          || request.resource.data.durationMinutes == null
          || (request.resource.data.durationMinutes is int
            && request.resource.data.durationMinutes >= 30
            && request.resource.data.durationMinutes <= 480));

      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'title', 'description', 'priority', 'dueDate', 'completed',
            'completedDate', 'completedDates', 'startTime', 'durationMinutes'
          ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.description is string
        && request.resource.data.priority in ['urgent', 'important', 'normal']
        && (request.resource.data.dueDate == null
          || request.resource.data.dueDate is string)
        && request.resource.data.completed is bool
        && (!request.resource.data.keys().hasAny(['completedDate'])
          || request.resource.data.completedDate == null
          || request.resource.data.completedDate is string)
        && (!request.resource.data.keys().hasAny(['completedDates'])
          || (request.resource.data.completedDates is list
            && request.resource.data.completedDates.size() <= 3660))
        && (!request.resource.data.keys().hasAny(['startTime'])
          || request.resource.data.startTime == null
          || (request.resource.data.startTime is string
            && request.resource.data.startTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))
        && (!request.resource.data.keys().hasAny(['durationMinutes'])
          || request.resource.data.durationMinutes == null
          || (request.resource.data.durationMinutes is int
            && request.resource.data.durationMinutes >= 30
            && request.resource.data.durationMinutes <= 480));
    }

    match /users/{userId}/monthlyGoals/{month} {
      allow read: if request.auth != null
        && request.auth.uid == userId;

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'habitTarget', 'taskTarget', 'updatedAt'
        ])
        && request.resource.data.habitTarget is int
        && request.resource.data.habitTarget >= 1
        && request.resource.data.habitTarget <= 1000
        && request.resource.data.taskTarget is int
        && request.resource.data.taskTarget >= 1
        && request.resource.data.taskTarget <= 1000
        && request.resource.data.updatedAt is timestamp;

      allow delete: if false;
    }

    match /timeEntries/{entryId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;

      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'category', 'project', 'taskId', 'taskTitle',
          'startedAt', 'endedAt', 'durationSeconds', 'userId'
        ])
        && request.resource.data.category in [
          'code', 'study', 'leisure', 'wellbeing', 'admin', 'other'
        ]
        && request.resource.data.project is string
        && request.resource.data.project.size() <= 100
        && (request.resource.data.taskId == null
          || request.resource.data.taskId is string)
        && (request.resource.data.taskTitle == null
          || (request.resource.data.taskTitle is string
            && request.resource.data.taskTitle.size() <= 100))
        && request.resource.data.startedAt is timestamp
        && request.resource.data.endedAt is timestamp
        && request.resource.data.endedAt >= request.resource.data.startedAt
        && request.resource.data.durationSeconds is int
        && request.resource.data.durationSeconds > 0
        && request.resource.data.durationSeconds <= 31536000;

      allow update, delete: if false;
    }

    match /{path=**}/completions/{date} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }
  }
}
